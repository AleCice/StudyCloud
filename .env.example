# =========================================================================
# StudyCloud Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to version control.
# =========================================================================

# Supabase (Database, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Google Gemini AI (Required for RAG embeddings, chat, and tutor)
GEMINI_API_KEY=your_google_gemini_api_key

# Optional AI Providers (for future adapters)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Application Host URL (e.g., https://studycloud.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private Platform Invite Code (Leave empty to allow admin-only Supabase invites, or set a code for invited registrations)
APP_INVITE_CODE=your_secret_invite_code_2026


